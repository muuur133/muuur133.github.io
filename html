<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <title>Простой пример</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        text-align: center;
        padding-top: 50px;
        background-color: #f5f5f5;
      }
      h1 {
        color: #333;
      }
      button {
        padding: 10px 20px;
        font-size: 16px;
        cursor: pointer;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
      }
      button:hover {
        background-color: #0056b3;
      }
      #message {
        margin-top: 20px;
        font-weight: bold;
        color: #2e7d32;
      }
    </style>
  </head>
  <body>
    <h1>Привет, это HTML!</h1>
    <button onclick="showMessage()">Нажми меня</button>
    <div id="message"></div>

    <script>
      function showMessage() {
        const messageDiv = document.getElementById('message');
        messageDiv.textContent = 'Ты нажал кнопку! 🎉';
      }
    </script>
  </body>
</html>
